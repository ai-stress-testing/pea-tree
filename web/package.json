{
  "name": "pea-tree-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vue + TS harness over Ollama: iterative groupchat, messaging, Mermaid, kanban.",
  "scripts": {
    "personas": "node ../scripts/build_personas.mjs",
    "dev": "npm run personas && vite",
    "build": "npm run personas && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "qa": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "mermaid": "^11.4.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
